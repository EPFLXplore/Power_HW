				(face "Arial")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "7c8d0fdd-9690-4c51-9bb6-151cd027db55")
	)
	(text_box "Shunt value:\nV = IR => max 20A for 5v case => R = V/I = 40.96mV / 20 A = 0.002 R\nV = IR => max 20A for 5v case => R = V/I = 163.64mV / 20 A = 0.008 R\n\n40.96mV gives higher resolution so its preferable"
		(exclude_from_sim no)
		(at 327.66 19.05 0)
		(size 27.94 25.4)
		(margins 1.3525 1.3525 1.3525 1.3525)
		(stroke
			(width 0.8)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
