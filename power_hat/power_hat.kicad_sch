			)
			(justify left top)
		)
		(uuid "a3860419-e9e5-4f27-8447-b273767e85e8")
	)
	(text_box "Rillim puts a constant current protection but only triggered if overcurent < fast-trip current (I_{FT}). I_{FT} = 210% I_{illim} so immediate response in case of short in cables. Else we don't care.\n\nR_{illim} = 1460 / (I_{LIM(A)} - 0.11)\n\nLimit put at <120% of TRACO Imax (as TRACOS load limit is 120%-150% of Imax)\n\nRillim = 83R => 18A for 5V,\nRillim = 137R => 11A for 15V,\nRillim = 150R => 10A for 24V\n"
		(exclude_from_sim no)
		(at 150.876 181.2838 0)
		(size 65.024 40.9662)
		(margins 1.3525 1.3525 1.3525 1.3525)
		(stroke
			(width 0.8)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "acdc1373-fbd3-478f-9813-9f50e4a98e9b")
	)
