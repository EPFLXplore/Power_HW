				(face "Arial")
				(size 1.778 1.778)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "8c4bc9e9-7140-451d-9caf-bbf3a2b0f45a")
	)
	(text_box "ADM - ONLY 24V\n5V and 15V values remain untested as for the v1. Only values for 24V were redesigned. "
		(exclude_from_sim no)
		(at 24.13 313.69 0)
		(size 86.36 11.4652)
		(margins 1.3525 1.3525 1.3525 1.3525)
		(stroke
			(width 0.8)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
