				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "8bb114e2-30be-494d-9a27-73039b08bce6")
	)
	(text_box "ADM - UV/OV/FLB \nv1 Design put the FLB higher than the VRAIL for higher SOA margin as FLB limits the actual current until the stablished value aka if the value is never reached then nominal ILIM is never reached (set to 10A so that we have 9.3 with this). Left the same on v2."
		(exclude_from_sim no)
		(at 24.13 292.1 0)
		(size 86.36 19.05)
		(margins 1.3525 1.3525 1.3525 1.3525)
		(stroke
			(width 0.8)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
