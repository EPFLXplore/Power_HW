				(size 1.778 1.778)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "8d1fe1e0-f2a9-467d-b970-92f943b296ce")
	)
	(text_box "I_{load(A)} = V_{imon(uV)} / (R_{imon(R)} * G_{imon(uA/A)})\nFor V_{in}>5V -> Recommended max V_{imon}=3.3v\nG_{imon} = 243 uA/A typ.\n\nFrom Excel:\n5V => 465R\n15V => 750R\n24V => 825R\n\n\nAnyways we are not using it, dedicated INA better (analog values can drift over long distances -> loss of accuracy)"
		(exclude_from_sim no)
		(at 224.282 177.9818 0)
