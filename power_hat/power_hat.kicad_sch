	(text_box "ADM - ISET\nAdded resistor footprints for v2, put 0R for 10A limit like in v1. "
		(exclude_from_sim no)
		(at 130.81 386.0448 0)
		(size 63.5 11.4652)
		(margins 1.3525 1.3525 1.3525 1.3525)
		(stroke
			(width 0.8)
			(type solid)
			(color 200 200 200 1)
