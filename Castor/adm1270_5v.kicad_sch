	(text "Power Good : \nVpg = 1V * (1 + Rdiv1 / Rdiv2)"
		(exclude_from_sim no)
		(at 254.762 85.344 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2f4e450a-71d6-4be0-b1d7-cf720539bf60")
	)
	(text "Foldback : \nPFET SOA 10ms when I~10A\n==> Vds = 37 mV\nWe want the folddback when Vout > Vin - 37mV\nVflb = Vin - 0.37 = Iset/2 (1 + Rdiv1 / Rdiv2)"
		(exclude_from_sim no)
		(at 258.318 73.406 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "40f945ea-672f-43b8-a71a-a6cbb39ad3e6")
	)
	(text "MOSFET SOA : \nWith Vcc between 16 and 31V :\nVgate and Vrpfg always roughly Vcc - 10~12V\n==>   Vgs ~= 10~12V\nWith the NVTFS5116 MOSFET : \nalways in linear mode\nMOSFET in DC mode for current up to 15A\n(see \"On−Region Characteristics\" and \"Safe Operating Area\"\n"
		(exclude_from_sim no)
		(at 65.786 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "462aa50f-102d-4717-ad8d-01da87a40953")
	)
	(text "ENABLE wired to FAULT to setup \nthe device in auto-retry mode"
		(exclude_from_sim no)
		(at 139.7 166.116 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "674cd5c8-aef6-4641-8e2e-70fab93fa5ef")
	)
	(text "UV = 18V <=> Vuv = 1V		\nOV = 30V <=> Vov = 1V\nR_divider fixed to 332k\n	==>\n{ 18 /(332+x+y) = 1/(x+y)\n{ 30 / (332+x+y) = 1/y\n	<=>\nx = 7,8k 	y= 11,7k\n\nWith R_div2 = 12k and R_div3 = 10k\nUV = 19.2V and OV = 35V"
		(exclude_from_sim no)
		(at 50.8 102.108 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9acb81bd-a9e4-41a1-ac74-e58814baa89a")
	)
	(text "MOSFET SOA : \nWith Vcc between 16 and 31V :\nVgate and Vrpfg always roughly Vcc - 10~12V\n==>   Vgs ~= 10~12V\nWith the NVTFS5116 MOSFET : \nalways in linear mode\nMOSFET in DC mode for current up to 15A\n(see \"On−Region Characteristics\" and \"Safe Operating Area\"\n"
		(exclude_from_sim no)
		(at 204.724 26.162 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9e648bec-7fdd-4a99-9a7a-f7c084585d61")
	)
	(text "With Vsense in defalut mode :\nVsense limit = 50mV\nIlim = 5A\n==> R = 10 mOhm"
		(exclude_from_sim no)
		(at 145.034 29.972 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bd654d29-7f63-4e94-a45a-311839c057a4")
	)
