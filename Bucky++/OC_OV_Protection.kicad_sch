	(text_box "5V Rail e-fuse\n"
		(exclude_from_sim no)
		(at 31.75 44.45 0)
		(size 91.44 7.62)
		(margins 1.9049 1.9049 1.9049 1.9049)
		(stroke
			(width -0.0001)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(face "Times New Roman")
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
				(color 162 22 34 1)
			)
			(justify bottom)
		)
		(uuid "d0a078f1-15ab-45f1-899e-c92d3c9a8924")
	)
	(text_box "DESIGN NOTE:\nA 1mOhm Shunt resistor is used to set the current limit at 35A (I=35mV/1mOhm).\nVsense is set at 35mV using a voltage divider setting Viset at 1.403V: 3.6V*(2.3k/5.9k)\nViset = Vsense*40\n\nThe Under-Voltage UV and Over-Voltage OV thresholds are set using a three-resistor divider against the internal 1V reference VREF.\n\nUnder-Voltage UV Threshold V_UV The UV pin monitors the voltage divider formed by R1 on the high side and R2 plus R3 on the low side. V_UV equals 1V times 1 plus 19.23 which results in 20.23V. V_UV = 20.23V\n\nOver-Voltage OV Threshold V_OV The OV pin monitors the voltage divider formed by R1 plus R2 on the high side and R3 on the low side. The total high side resistance is  1015k Ohms. V_OV equals 1V times 1 plus the ratio of 1015k Ohms to 37k Ohms. V_OV equals 1V times 1 plus 27.43 which results in 28.43V. V_OV = 28.43V"
		(exclude_from_sim no)
		(at 261.62 13.97 0)
		(size 142.24 26.67)
		(margins 1.3525 1.3525 1.3525 1.3525)
		(stroke
			(width 0.8)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "d5e6b7ac-e510-4c24-8f69-8d4ebe58bcdd")
	)
	(text_box "DESIGN NOTE:\nOV = 10V\nUV = 14V\n"
