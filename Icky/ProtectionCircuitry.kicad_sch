				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "32ff4294-f476-4e4b-87e9-2ad7b5cacbb0")
	)
	(text_box "DESIGN NOTE - Difference between VIN and VMOT:\nAs in order to have hardware protections on rails, on bucks and on motors we need a current limiter and not a circuit breaker. That was Bucky. Due to it not working (rails assembly, ADM1270 design). The motors protections need to let pass the current demanded by the precharge circuit which is around 30A to 100A depending on which voltage and not trip for 1ms\nTo summarize: I decided to finish the board with this setup and I'll see if I can add a protection for the motors that might or not work but we can bypass."
		(exclude_from_sim no)
		(at 222.25 30.48 0)
		(size 36.83 34.29)
		(margins 1.3525 1.3525 1.3525 1.3525)
		(stroke
			(width 0.8)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "903a3840-eac1-4794-8b2d-5e799e4c7794")
	)
	(text_box "DESIGN NOTE - Rating\nIn order to maintain the rating the PCB needs to be routed to ensure that 50 to 60A with some margin can pass"
		(exclude_from_sim no)
		(at 44.45 148.59 0)
		(size 27.94 15.24)
		(margins 1.3525 1.3525 1.3525 1.3525)
