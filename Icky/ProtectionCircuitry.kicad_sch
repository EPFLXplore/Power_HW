	(text_box "DESIGN NOTE:\nThe shunt resistance value was chosen to handle a range of :\n- 40.96/1 = 40.96 A range for the battery input\n"
		(exclude_from_sim no)
		(at 15.875 148.59 0)
		(size 25.4 15.24)
		(margins 1.3525 1.3525 1.3525 1.3525)
		(stroke
