	(text_box "DESIGN NOTE - REASONING\nSeparate protections for bucks and motors was chosen becuase of the fact that the precharge circuit used at xplore is based on the TPS2490 which is not that much of a technical precharge but an inrush limiter. That function is the same as the original ADM1270 on Bucky. Due to the issues of the ADM and the ease of sizing NMOS vs PMOS transistors for power this LM5069 was chosen. Its TI's next gen TPS, almost the same excel for dimensionning but with OV/UV protections."
		(exclude_from_sim no)
		(at 178.435 53.34 0)
		(size 72.39 16.51)
		(margins 1.3525 1.3525 1.3525 1.3525)
		(stroke
			(width 0.8)
			(type solid)
			(color 200 200 200 1)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "c38e761e-2590-4e6c-848d-ab0c1f0c9ca3")
	)
